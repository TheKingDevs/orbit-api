{
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "module": "esnext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": false,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "fallbackPolling": "dynamic",
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@services/*": ["src/services/*"],
      "@utils/*": ["src/utils/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@errors/*": ["src/errors/*"],
      "@routes/*": ["src/routes/*"],
      "@types/*": ["src/types/*"],
      "@models/*": ["src/models/*"],
      "@interface/*": ["src/interface/*"]
    }
  },
  "include": ["src/**/*"]
}