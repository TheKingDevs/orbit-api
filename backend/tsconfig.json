{
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "module": "esnext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": false,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@services/*": ["./src/services/*"],
      "@utils/*": ["./src/utils/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@errors/*": ["./src/errors/*"],
      "@routes/*": ["./src/routes/*"],
      "@apptypes/*": ["./src/types/*"],
      "@models/*": ["./src/models/*"],
      "@interface/*": ["./src/interface/*"],
      "@modules/*": ["./src/modules/*"]
    }
  },
  "include": ["src/**/*"]
}
