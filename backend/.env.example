PORT=3000
BACKEND_URL=http://localhost:3000

# Frontend em produção ( Configure e descomente antes do deploy )
# FRONTEND_URL=

# Frontend de desenvolvimento ( Comente antes do deploy )
FRONTEND_URL=http://localhost:3001

# Google OAuth (obtenha em https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# Deve apontar para o proxy do frontend (Next.js) que encaminha ao backend.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Sessões e cookies
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=120
SESSION_ROTATE_HOURS=24

# Use true atrás de HTTPS. Em desenvolvimento local (HTTP) use false.
COOKIE_SECURE=false

# API keys de desenvolvimento. Em produção, defina valores aleatórios fortes.
OWNER_API_KEY=
ADMIN_API_KEY=
PUBLIC_API_KEY=
OWNER_EMAIL=thekingkodersdevs@gmail.com

# Origens web autorizadas para chamadas cross-origin; informe apenas origins (sem caminho).
# Separe múltiplas origens por vírgula. Exemplo: https://app.exemplo.com,https://admin.exemplo.com
CORS_ORIGIN=http://localhost:3001
PUBLIC_BASE_URL=http://localhost:3000

# Tempos limite em milissegundos (opcionais). Aumente em instâncias de hospedagem
# com pouca CPU ou provedores externos lentos.
# PROVIDER_TIMEOUT_MS=25000
# TRANSCRIPTION_TIMEOUT_MS=90000
# TRANSCRIPTION_PROCESS_TIMEOUT_MS=75000
# LOCAL_PROCESS_TIMEOUT_MS=30000
# MEDIA_FETCH_TIMEOUT_MS=15000
# AI_HORDE_TIMEOUT_MS=15000

# Limite diário de pré-visualizações da documentação por usuário.
DOCS_PREVIEW_DAILY_LIMIT=100

# MongoDB
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/
MONGO_DB_NAME=orbit

# Mercado Pago Checkout Pro Orders API
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Configure esta URL no painel do Mercado Pago para eventos de Orders:
# https://api.seudominio.com/api/webhooks/mercado-pago

# Chave para hash HMAC-SHA256 e criptografia AES-256-GCM dos dados sensíveis.
# Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Opcional: chave AI Horde para associar gerações à conta e aumentar prioridade.
AIHORDE_API_KEY=

# Caminho opcional do executável Tesseract OCR. Por padrão, busca "tesseract" no PATH.
TESSERACT_PATH=
