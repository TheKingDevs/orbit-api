PORT=3000
BACKEND_URL=http://localhost:3000

# Frontend em produção ( Configure e descomente antes do deploy )
# FRONTEND_URL=

# Frontend de desenvolvimento ( Comente antes do deploy )
FRONTEND_URL=http://localhost:3001

# Google OAuth (obtenha em https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# Deve apontar para o proxy do frontend (Next.js) que encaminha ao backend.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Sessões e cookies
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=120
SESSION_ROTATE_HOURS=24

# Use true atrás de HTTPS. Em desenvolvimento local (HTTP) use false.
COOKIE_SECURE=false

# API keys de desenvolvimento. Em produção, defina valores aleatórios fortes.
OWNER_API_KEY=
ADMIN_API_KEY=
PUBLIC_API_KEY=

CORS_ORIGIN=http://localhost:3001

# Limite diário de pré-visualizações da documentação por usuário.
DOCS_PREVIEW_DAILY_LIMIT=100

# MongoDB
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/
MONGO_DB_NAME=orbit
