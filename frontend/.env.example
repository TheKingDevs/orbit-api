# URL pública da API usada nos exemplos de código (opcional, padrão: origem atual)
NEXT_PUBLIC_API_URL=
# URL do canal de atualizações exibido no dashboard (opcional)
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
