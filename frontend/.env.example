# URL interna do backend (usada pelo proxy do Next.js, não exposta ao browser)
BACKEND_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=Orbit API

# URL pública do site usada em SEO, Open Graph, sitemap e robots (opcional)
NEXT_PUBLIC_SITE_URL=https://0rbit-api.vercel.app

# URL pública da API usada nos exemplos de código (opcional, padrão: origem atual)
NEXT_PUBLIC_API_URL=

# URL do canal de atualizações exibido no dashboard (opcional)
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=

# Link de convite do grupo de suporte (opcional)
NEXT_PUBLIC_WHATSAPP_SUPPORT_URL=
